<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-pipeline-nodes-table" author="hyperion-etl">
        <createTable tableName="pipeline_nodes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pipeline_id" type="UUID">
                <constraints nullable="false" 
                             foreignKeyName="fk_pipeline_nodes_pipeline"
                             referencedTableName="pipelines"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="domain_service" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="config" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="pos_x" type="INTEGER"/>
            <column name="pos_y" type="INTEGER"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
